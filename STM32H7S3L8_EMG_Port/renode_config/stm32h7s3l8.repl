# STM32H7S3L8 Platform Description for Renode
# Defines the complete hardware platform for EMG system emulation

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    nvic: nvic
    PerformanceInMips: 1100

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 550000000
    IRQ -> cpu@0

# Memory Map - STM32H7S3L8 specific
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000  # 2MB Flash

# AXI SRAM - High-speed data processing
axi_sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x80000   # 512KB

# SRAM1 - Filter coefficients and states
sram1: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x20000   # 128KB

# SRAM2 - Processed data and system variables
sram2: Memory.MappedMemory @ sysbus 0x10020000
    size: 0x20000   # 128KB

# SRAM3 - System critical data
sram3: Memory.MappedMemory @ sysbus 0x10040000
    size: 0x8000    # 32KB

# SRAM4 - Available for expansion
sram4: Memory.MappedMemory @ sysbus 0x10050000
    size: 0x10000   # 64KB

# Peripherals
# UART1 - Primary EMG data communication
uart1: UART.STM32F4_UART @ sysbus 0x40011000
    frequency: 137500000
    IRQ -> nvic@37

# SPI1 - ADS1299 communication
spi1: SPI.STM32SPI @ sysbus 0x40013000
    IRQ -> nvic@35

# GPIO Banks
gpioA: GPIOPort.STM32_GPIOPort @ sysbus 0x40020000
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 16
    [0-15] -> nvic@6

gpioB: GPIOPort.STM32_GPIOPort @ sysbus 0x40020400
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 16
    [5-9] -> nvic@23

gpioC: GPIOPort.STM32_GPIOPort @ sysbus 0x40020800
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 16

# Timers
timer1: Timers.STM32_Timer @ sysbus 0x40010000
    frequency: 275000000
    IRQ -> nvic@25

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    frequency: 137500000
    IRQ -> nvic@28

# DMA Controllers
dma1: DMA.STM32DMA @ sysbus 0x40020000
    [0-7] -> nvic@[11-17,47]

dma2: DMA.STM32DMA @ sysbus 0x40020400
    [0-7] -> nvic@[56-60,68-70]

# DMAMUX - Enhanced DMA request routing
dmamux: DMA.STM32DMAMUX @ sysbus 0x40020800

# RCC - Reset and Clock Control
rcc: Miscellaneous.STM32F4_RCC @ sysbus 0x40021000
    rtcFrequency: 32768

# EXTI - External Interrupt Controller
exti: IRQControllers.EXTI @ sysbus 0x40010400
    [0-15] -> nvic@[6-10,23,40]

# PWR - Power Control
pwr: Miscellaneous.STM32_PWR @ sysbus 0x40007000

# SYSCFG - System Configuration
syscfg: Miscellaneous.STM32_SYSCFG @ sysbus 0x40010000

# Flash Interface
flash_interface: MTD.STM32_FlashController @ sysbus 0x40022000

# Cache Controllers (STM32H7S3L8 specific)
icache: Cache.STM32_Cache @ sysbus 0x40030400
    size: 0x8000    # 32KB I-Cache

dcache: Cache.STM32_Cache @ sysbus 0x40030000
    size: 0x8000    # 32KB D-Cache

# EMG System Specific Peripherals
# Virtual ADS1299 ADC
ads1299: Sensors.VirtualADS1299 @ sysbus 0x60000000
    channels: 8
    sampleRate: 1000
    resolution: 24
    spi -> spi1

# Virtual EMG Signal Generator
emg_generator: Sensors.VirtualEMGGenerator @ sysbus 0x60001000
    channels: 8
    amplitudeRange: 5000
    frequencyRange: [10, 450]
    noiseLevel: 0.1

# Button Input
button: Input.Button @ gpioA 0
    invert: true

# Status LEDs
led1: Miscellaneous.LED @ gpioB 0
    color: "green"

led2: Miscellaneous.LED @ gpioB 1
    color: "red"

# EMG Data Ready Signal
data_ready: GPIOPort.STM32_GPIOPort @ gpioA 2
    modeResetValue: 0x00000000